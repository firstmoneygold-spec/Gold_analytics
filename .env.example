# Django Core Settings
DJANGO_SECRET_KEY=change-this-to-a-super-secret-key-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite in local default)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/gold_analytics_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Market Data API Keys
FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=your_newsapi_key_here
FINANCIAL_MODELING_PREP_KEY=your_fmp_key_here

# SaaS Payment Gateways
# USA / Global (Stripe)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# India (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret...
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret...

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALERT_CHANNEL_ID=@your_channel_id
